  "validation": {
    "checks": [
      {
        "id": "check.docs",
        "command": [
          "deno",
          "task",
          "--cwd",
          ".github/skills/doc-validation",
          "check:docs"
        ],
        "cwd": ".",
        "whenChanged": [
          "README.md",
          "docs/**",
          ".github/**",
          ".ousia/**"
        ]
      },
      {
        "id": "check.rust",
        "command": [
          "ousia-rust-checker",
          "check-project",
          "."
        ],
        "cwd": ".",
        "whenChanged": [
          "Cargo.toml",
          "**/Cargo.toml",
          "**/*.rs",
          ".ousia/project.json"
        ]
      }
    ],
    "promptBudgets": [
      {
        "routeId": "route.plan-refactor-product",
        "maxAssets": 12,
        "maxPromptAssetCharacters": 36000
