{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "types": ["node"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["packages/ousia/src/**/*.ts", "packages/ousia/test/**/*.ts"],
  "exclude": ["**/dist/**", "**/node_modules/**"],
  "references": [{ "path": "./packages/ousia" }]
}