{
  "tasks": {
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint src test scripts smoke",
    "check": "deno check src/cli.ts src/mod.ts test/*.ts scripts/*.ts smoke/*.ts",
    "install": "deno run --allow-read --allow-write --allow-run scripts/install-cli.ts",
    "test": "deno test --allow-read --allow-write --allow-run --allow-env --allow-sys=uid test",
    "smoke:install": "deno run --allow-read --allow-write --allow-run --allow-env --allow-sys=uid smoke/install-smoke.ts",
    "release": "deno task fmt:check && deno task lint && deno task check && deno task test && deno task smoke:install"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.14",
    "@std/path": "jsr:@std/path@^1.1.2"
  },
  "fmt": {
    "include": ["scripts", "smoke", "src", "test", "deno.json"]
  },
  "lint": {
    "include": ["scripts", "smoke", "src", "test"]
  }
}
